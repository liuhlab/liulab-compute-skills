#!/bin/sh
# `edison-cli` as a bare command, wherever this plugin is installed.
#
# Claude Code puts `<plugin-root>/bin` on PATH unconditionally — whether or not the directory
# exists, and without restarting the session. `[verified]` 2026-09-05. So shipping this file is
# what turns every command in `skills/lab-edison/` into the short form its pages already write,
# and the permission rule `Bash(edison-cli:*)` into one that survives a release: the plugin cache
# holds one directory per version, so the explicit `pixi run --manifest-path <cache>/…` spelling
# carries a version number and stops matching the next time the plugin updates.
#
# `${CLAUDE_PLUGIN_ROOT}` is NOT available here — `[verified]` unset in the environment an agent's
# tool calls run in — so the root is resolved from this script's own location. Nothing depends on
# the working directory, which an agent harness resets between calls.
#
# `python -m edison_cli` and NEVER `pixi run … edison-cli`: the console script inside the pixi
# environment wears this same name, this wrapper is earlier on PATH, and calling it by name would
# make this file exec itself until the machine gives up. The module entry point cannot recurse.
#
# Codex copies the plugin and Kimi Code reads Claude Code's marketplace clone; neither puts a
# `bin/` on PATH. So `/lab-setup` links the clone's copy of this file into a directory already on
# PATH, for all three agents, and `$0` may be that link: it is followed to the clone below. The
# Python that runs is then the clone's, and in Claude Code and Codex it can be a release apart
# from the skill text loaded until the agent relaunches; ADR 0014 accepts that. Without the
# link, the fallback is the explicit form, which `SKILL.md` step 0 keeps and the preflight prints.
set -eu

if ! command -v pixi >/dev/null 2>&1; then
    printf 'edison-cli: pixi is not installed, and this command runs inside a pixi environment.\n' >&2
    printf 'Install it from https://pixi.sh, then run edison-cli preflight again.\n' >&2
    exit 127
fi

# Follow `$0` to the file itself, link by link: through `/lab-setup`'s link, `$0` is the link,
# and the directory above it is not the project. Plain `readlink` and `cd -P`, because
# `readlink -f` is GNU's alone. A relative target is read from the link's own directory, as
# the kernel reads it. `CDPATH=''` because a user's own CDPATH would otherwise make `cd` land
# somewhere else and print where it went. `--` because a path is not this script's to vouch for.
self=$0
while [ -L "$self" ]; do
    target=$(readlink -- "$self")
    case $target in
        /*) self=$target ;;
        *) self=$(dirname -- "$self")/$target ;;
    esac
    self=$(CDPATH='' cd -P -- "$(dirname -- "$self")" && pwd)/$(basename -- "$self")
done
root=$(CDPATH='' cd -- "$(dirname -- "$self")/.." && pwd)
exec pixi run --manifest-path "$root/pyproject.toml" python -m edison_cli "$@"
